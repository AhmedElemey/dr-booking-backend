{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clinic.config.schema.json",
  "title": "Clinic configuration",
  "description": "Identity and default feature switches of one clinic. Identical in the backend, website, mobile and console repositories.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "tagline", "colors", "logo", "supportPhone", "website", "mobile", "console", "features"],
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ar", "en"],
      "properties": {
        "ar": { "type": "string", "minLength": 1, "maxLength": 200 },
        "en": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "hexColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
  },
  "properties": {
    "$schema": { "type": "string" },
    "slug": { "type": "string", "maxLength": 40, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "$ref": "#/$defs/localized" },
    "tagline": { "$ref": "#/$defs/localized" },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "accent"],
      "properties": {
        "primary": { "$ref": "#/$defs/hexColor" },
        "accent": { "$ref": "#/$defs/hexColor" }
      }
    },
    "logo": { "type": "string", "minLength": 1, "description": "Path of the logo file relative to this file (SVG or PNG)." },
    "depositAmountEgp": { "type": "number", "minimum": 0, "default": 0 },
    "supportPhone": { "type": "string", "pattern": "^\\+?[0-9 ()-]{6,20}$" },
    "website": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain"],
      "properties": { "domain": { "type": "string", "minLength": 1 } }
    },
    "mobile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["androidApplicationId", "iosBundleId"],
      "properties": {
        "androidApplicationId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$" },
        "iosBundleId": { "type": "string", "minLength": 1 }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "clinicId"],
      "properties": {
        "url": { "type": "string", "description": "Base URL of the super admin console; empty disables the runtime pull." },
        "clinicId": { "type": "string" }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mobileApp", "website", "guestBrowsing", "patientSelfService", "pushReminders", "smsNotifications", "englishLanguage", "multiBranch", "videoConsultation", "waitingList", "familyAccounts", "whatsappReminders", "whatsappOtp", "onlinePayments", "insurance", "holidayCalendar", "workingHoursTemplates", "patientRecords", "reviews", "promotions", "recallCampaigns", "reports", "liveQueue", "manualReview", "publicPrices"],
      "properties": {
        "mobileApp": { "type": "boolean" },
        "website": { "type": "boolean" },
        "guestBrowsing": { "type": "boolean" },
        "patientSelfService": { "type": "boolean" },
        "pushReminders": { "type": "boolean" },
        "smsNotifications": { "type": "boolean" },
        "englishLanguage": { "type": "boolean" },
        "multiBranch": { "type": "boolean" },
        "videoConsultation": { "type": "boolean" },
        "waitingList": { "type": "boolean" },
        "familyAccounts": { "type": "boolean" },
        "whatsappReminders": { "type": "boolean" },
        "whatsappOtp": { "type": "boolean" },
        "onlinePayments": { "type": "boolean" },
        "insurance": { "type": "boolean" },
        "holidayCalendar": { "type": "boolean" },
        "workingHoursTemplates": { "type": "boolean" },
        "patientRecords": { "type": "boolean" },
        "reviews": { "type": "boolean" },
        "promotions": { "type": "boolean" },
        "recallCampaigns": { "type": "boolean" },
        "reports": { "type": "boolean" },
        "liveQueue": { "type": "boolean" },
        "manualReview": { "type": "boolean" },
        "publicPrices": { "type": "boolean" }
      }
    }
  }
}
