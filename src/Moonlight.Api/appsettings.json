{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "moonlight",
    "Audience": "moonlight",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Booking": {
    "MaxUpcomingPerPatient": 3,
    "PatientCancelWindowHours": 2,
    "MinLeadMinutes": 60
  },
  "RateLimits": {
    "OtpPerPhonePerMinute": 1,
    "OtpPerPhonePerHour": 5,
    "OtpPerIpPerHour": 20
  },
  "Sms": {
    "Provider": "Log",
    "NotificationsEnabled": false
  },
  "Reminders": {
    "Enabled": true,
    "IntervalMinutes": 5
  },
  "Storage": {
    "Path": "uploads",
    "RequestPath": "/uploads"
  },
  "Payments": {
    "Provider": "Mock",
    "PublicBaseUrl": "",
    "ReturnUrlHosts": [],
    "Paymob": {
      "BaseUrl": "https://accept.paymob.com",
      "ApiKey": "",
      "IntegrationId": "",
      "IframeId": "",
      "HmacSecret": ""
    }
  },
  "WhatsApp": {
    "Provider": "Mock",
    "ApiBaseUrl": "https://graph.facebook.com/v21.0",
    "PhoneNumberId": "",
    "AccessToken": "",
    "LanguageCodeAr": "ar",
    "LanguageCodeEn": "en",
    "Templates": {
      "confirmed": "",
      "cancelled": "",
      "reminder": "",
      "waitlist": "",
      "review": "",
      "recall": ""
    }
  },
  "Video": {
    "Provider": "Jitsi",
    "Jitsi": {
      "BaseUrl": "https://meet.jit.si"
    }
  },
  "Jobs": {
    "ReviewPromptDelayMinutes": 30,
    "RecallHour": 10
  }
}
