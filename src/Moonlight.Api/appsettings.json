{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "moonlight",
    "Audience": "moonlight",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Booking": {
    "MaxUpcomingPerPatient": 3,
    "PatientCancelWindowHours": 2,
    "MinLeadMinutes": 60
  },
  "RateLimits": {
    "OtpPerPhonePerMinute": 1,
    "OtpPerPhonePerHour": 5,
    "OtpPerIpPerHour": 20
  },
  "Sms": {
    "Provider": "Log",
    "NotificationsEnabled": false
  },
  "Reminders": {
    "Enabled": true,
    "IntervalMinutes": 5
  },
  "Storage": {
    "Path": "uploads",
    "RequestPath": "/uploads"
  }
}
